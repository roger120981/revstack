# Revstack production environment variables
# Copy to .env.production and fill in real values

DATABASE_URL=ecto://revstack:YOUR_DB_PASSWORD@127.0.0.1/revstack_prod
SECRET_KEY_BASE=
TOKEN_SIGNING_SECRET=
PHX_HOST=revenuelink.net
PHX_SERVER=true
PORT=4000
MIX_ENV=prod
POOL_SIZE=10
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional: MaxMind GeoLite2
# MAXMIND_ACCOUNT_ID=
# MAXMIND_LICENSE_KEY=
